{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Module 04 Oil Spill Movement & Source Estimation Output",
  "description": "Standardized output from Module 04 for downstream consumption",
  "type": "object",
  "required": [
    "spill_id",
    "timestamp",
    "source_estimation",
    "spill_movement",
    "spill_extent",
    "environmental_conditions",
    "risk"
  ],
  "properties": {
    "spill_id": {
      "type": "string",
      "description": "Unique identifier for this spill event",
      "example": "SPILL_001"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when analysis was performed",
      "example": "2026-08-26T09:30:00Z"
    },
    "source_estimation": {
      "type": "object",
      "required": ["latitude", "longitude", "confidence"],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence score 0-1"
        },
        "method": {
          "type": "string",
          "description": "How source was estimated (backtracking, forward_inverse, etc.)",
          "example": "backward_drift_trace"
        }
      }
    },
    "spill_movement": {
      "type": "object",
      "properties": {
        "current_position": {
          "type": "object",
          "required": ["latitude", "longitude"],
          "properties": {
            "latitude": {"type": "number"},
            "longitude": {"type": "number"},
            "timestamp": {"type": "string", "format": "date-time"}
          }
        },
        "predicted_positions": {
          "type": "array",
          "description": "Future trajectory predictions",
          "items": {
            "type": "object",
            "properties": {
              "time": {"type": "string", "format": "date-time"},
              "latitude": {"type": "number"},
              "longitude": {"type": "number"}
            }
          }
        },
        "trajectory_geometry": {
          "type": "object",
          "description": "GeoJSON LineString of predicted trajectory",
          "example": {
            "type": "LineString",
            "coordinates": [[74.5678, 12.3456], [74.5700, 12.3480]]
          }
        }
      }
    },
    "spill_extent": {
      "type": "object",
      "properties": {
        "area_km2": {
          "type": "number",
          "description": "Estimated spill area in square kilometers"
        },
        "geometry": {
          "type": "object",
          "description": "GeoJSON Polygon of spill boundary",
          "properties": {
            "type": {"type": "string", "enum": ["Polygon"]},
            "coordinates": {"type": "array"}
          }
        }
      }
    },
    "environmental_conditions": {
      "type": "object",
      "properties": {
        "wind_speed_ms": {"type": "number"},
        "wind_direction_deg": {"type": "number"},
        "current_speed_ms": {"type": "number"},
        "current_direction_deg": {"type": "number"},
        "sea_surface_temp_c": {"type": "number"}
      }
    },
    "risk": {
      "type": "object",
      "properties": {
        "risk_level": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
        },
        "coastal_impact_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "simulation_duration_hours": {"type": "integer"},
        "num_particles": {"type": "integer"},
        "particle_count_at_end": {"type": "integer"},
        "notes": {"type": "string"}
      }
    }
  }
}